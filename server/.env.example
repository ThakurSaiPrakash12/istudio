PORT=5000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional: MongoDB connection string (if not provided, in-memory storage will be used)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lumen_studio?retryWrites=true&w=majority

# Optional: Cloudinary configuration for image uploads
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
